# ── database ────────────────────────────────────────────────────────────────
# Schema owner: runs migrations only (pnpm db:migrate). Never used by the apps.
DATABASE_URL_OWNER=postgres://postgres:postgres@localhost:5432/simorgh
# API: application role, no owner rights, no BYPASSRLS
DATABASE_URL=postgres://simorgh_app:app-dev@localhost:5432/simorgh
# Worker (outbox relay): BYPASSRLS, but granted only the outbox tables
WORKER_DATABASE_URL=postgres://simorgh_worker:worker-dev@localhost:5432/simorgh

# ── API ─────────────────────────────────────────────────────────────────────
PORT=4000
# at least 32 random characters: openssl rand -base64 48
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000

# ── object storage (MinIO / S3) ─────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=simorgh
S3_ACCESS_KEY=simorgh
S3_SECRET_KEY=simorgh-dev-secret

# ── message bus ─────────────────────────────────────────────────────────────
AMQP_URL=amqp://guest:guest@localhost:5672

# ── web ─────────────────────────────────────────────────────────────────────
API_URL=http://localhost:4000

# ── first platform administrator (pnpm --filter @simorgh/api seed:platform-admin)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
